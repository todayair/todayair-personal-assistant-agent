# ===== 必填 =====
LLM_MODEL=deepseek:deepseek-v4-flash
DEEPSEEK_API_KEY=sk-xxxx
SYSTEM_PROMPT=你是一个友好的 AI 助手，可以用多种工具帮助用户解决问题。

# ===== 可选 =====
# 上下文压缩摘要模型（默认与主模型相同）
# SUMMARY_MODEL=deepseek:deepseek-v3
# SUMMARY_TARGET_TOKENS=100000

# GitHub MCP 工具（需本机安装 Docker）
# GITHUB_PERSONAL_ACCESS_TOKEN=ghp_xxxx


# ===== 国内邮箱（可选，QQ / 163 / 126 / Outlook；未填则不启用）=====
# 需在邮箱网页端开启 IMAP/SMTP 服务并生成授权码（不是登录密码），配置步骤见 README「国内邮箱」章节
# EMAIL_PROVIDER=qq            # qq | 163 | 126 | outlook | custom（默认 qq）
# EMAIL_ADDRESS=yourname@qq.com
# EMAIL_PASSWORD=你的授权码
# EMAIL_USERNAME=              # 可选，默认同 EMAIL_ADDRESS
# EMAIL_IMAP_HOST=             # 自定义 IMAP 服务器（provider=custom 时必填）
# EMAIL_IMAP_PORT=             # 可选，默认 993
# EMAIL_IMAP_MODE=           # 可选 ssl | starttls | plain（默认按端口：993=ssl，其他=starttls）
# EMAIL_SMTP_HOST=             # 自定义 SMTP 服务器（provider=custom 时必填）
# EMAIL_SMTP_PORT=             # 可选，默认 465
# EMAIL_SMTP_STARTTLS=         # 可选 true/false，默认按预设（465=SSL / 587=STARTTLS）
# EMAIL_ATTACHMENT_DIR=.agent_email_attachments

# ===== 记忆系统（默认即可）=====
# MEMORY_ENABLED=true
# MEMORY_TOP_K=3
# MEMORY_MIN_SIMILARITY=0.4
# MEMORY_DEDUP_SIMILARITY=0.85
# MEMORY_HYBRID=true
# MEMORY_DIR=.agent_memory
# MEMORY_COLLECTION=agent_memory

# ===== 个人数据持久化（待办/笔记/提醒 + 历史会话）=====
# 必填：本程序只使用 MySQL 存储，完全不使用本地 JSON 文件。
# 待办/笔记/提醒写入 agent_personal 库，历史会话写入 agent_history 库
# （首次启动自动建库建表，并自动迁移旧版 .agent_personal/ 与 .agent_history/
# 目录下的存量 JSON 数据，仅一次性迁移）。
# MySQL 初始化失败会直接报错终止启动，绝不回退 JSON。
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_password
# MYSQL_DATABASE=  # 可选：显式指定库名（默认个人数据用 agent_personal、历史会话用 agent_history）
