# ===== 必填 =====
LLM_MODEL=deepseek:deepseek-v4-flash
DEEPSEEK_API_KEY=sk-xxxx
SYSTEM_PROMPT=你是一个友好的 AI 助手，可以用多种工具帮助用户解决问题。

# ===== 可选 =====
# 上下文压缩摘要模型（默认与主模型相同）
# SUMMARY_MODEL=deepseek:deepseek-v3
# SUMMARY_TARGET_TOKENS=100000

# GitHub MCP 工具（需本机安装 Docker）
# GITHUB_PERSONAL_ACCESS_TOKEN=ghp_xxxx

# ===== 记忆系统（默认即可）=====
# MEMORY_ENABLED=true
# MEMORY_TOP_K=3
# MEMORY_MIN_SIMILARITY=0.4
# MEMORY_DIR=.agent_memory
# MEMORY_COLLECTION=agent_memory

# ===== 个人数据持久化（待办/笔记/提醒 + 历史会话）=====
# 必填：本程序只使用 MySQL 存储，完全不使用本地 JSON 文件。
# 待办/笔记/提醒写入 agent_personal 库，历史会话写入 agent_history 库
# （首次启动自动建库建表，并自动迁移旧版 .agent_personal/ 与 .agent_history/
# 目录下的存量 JSON 数据，仅一次性迁移）。
# MySQL 初始化失败会直接报错终止启动，绝不回退 JSON。
MYSQL_ENABLED=true
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_password
# MYSQL_DATABASE=  # 可选：显式指定库名（默认个人数据用 agent_personal、历史会话用 agent_history）
